# Production deferred transactions, keyed by file::function, with a read-only reason.
crates/striatum-store/src/lib.rs::read_resolved_facts # SELECT-only snapshot of model facts and operator-grade overlays; no transaction writes.
crates/striatum-store/src/account_selection.rs::reconcile_account_eligibility # SELECT-only listing snapshot commits before the separate IMMEDIATE write phase.
crates/striatum-store/src/account_selection.rs::account_read # Callback contract permits reads only; admissions and observations use account_transaction.
